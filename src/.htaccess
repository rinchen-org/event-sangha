Options -Indexes
RewriteEngine On

# Never serve configuration, databases/backups, internal PHP, or raw HTML pages.
RewriteRule (^|/)\. - [F,END]
RewriteRule ^(?:lib|migrations)/ - [F,END,NC]
RewriteRule \.(?:sqlite(?:3)?(?:[-.].*)?|db(?:[-.].*)?|sql|bak|ini|log|html?)$ - [F,END,NC]

# Existing QR URLs must go through PHP session verification, not static serving.
RewriteRule ^static/qr/([a-f0-9]{64}\.jpg)$ media.php?file=$1 [END]
RewriteRule ^static/qr(?:/|$) - [F,END]

<IfModule mod_headers.c>
    Header always set X-Content-Type-Options "nosniff"
    Header always set Referrer-Policy "no-referrer"
</IfModule>
